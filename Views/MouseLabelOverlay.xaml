<views:OverlayWindowBase
    x:Class="OopsType.Views.MouseLabelOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:OopsType.Views">
    <Border CornerRadius="3" Padding="4,1" Background="#CC222222">
        <TextBlock Text="{Binding Code}"
                   Foreground="White"
                   FontFamily="{Binding FontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="SemiBold"/>
    </Border>
</views:OverlayWindowBase>
