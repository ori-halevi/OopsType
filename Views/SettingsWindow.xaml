<ui:FluentWindow x:Class="OopsType.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:loc="clr-namespace:OopsType.Markup"
        xmlns:ctrl="clr-namespace:OopsType.Views.Controls"
        xmlns:conv="clr-namespace:OopsType.Converters"
        xmlns:behaviors="clr-namespace:OopsType.Behaviors"
        Title="{loc:T Window_Title}"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="980" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <!-- ===== Tokens ===== -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" Opacity="0.65"/>
        <SolidColorBrush x:Key="CardBorder" Color="#22000000"/>
        <SolidColorBrush x:Key="SubtleText" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="AccentText" Color="#FF1F2937"/>
        <SolidColorBrush x:Key="PreviewBackground" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="PreviewSurface" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PreviewBorder" Color="#FFE5E7EB"/>
        <SolidColorBrush x:Key="DocLine" Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="DocCaret" Color="#FF111827"/>

        <!-- ===== Common card style ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Sidebar nav button -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Accent" Grid.Column="0"
                                           Width="4" RadiusX="2" RadiusY="2"
                                           Fill="Transparent"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Margin="-10,4,0,4"/>
                                <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#11000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2563EB"/>
                                <Setter TargetName="Accent" Property="Fill" Value="#FF2563EB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#FF1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page visibility: collapse a page when its tag != selected nav's tag -->
        <Style x:Key="PageRoot" TargetType="ScrollViewer">
            <!-- Visible (not Auto) so the scrollbar is always present as an explicit "this scrolls"
                 cue. The thumb shrinking below full height is the clearest signal there's more below,
                 and keeping it on every page also stops content from shifting width between a page
                 that scrolls and one that doesn't. -->
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="32,24,32,24"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <!-- Soft fade at the bottom/top edge so a page that scrolls past the fold reads as
                 having more content, instead of looking like the visible cards are all there is. -->
            <Setter Property="behaviors:ScrollViewerFade.Enabled" Value="True"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:LanguageNameConverter x:Key="LangName"/>
        <!-- Centres an auto-sized preview chip on its anchor: TranslateTransform = -ActualSize/2. -->
        <conv:ScaleConverter x:Key="HalfNegate"/>
        <!-- Caret preview X translate: centred (manual) vs left-edge beside-the-caret (auto). -->
        <conv:CaretPreviewXConverter x:Key="CaretPreviewX"/>

        <!-- Shared geometry for the two taskbar-strip preview swatches (one drawn behind the
             taskbar, one in front, toggled by placement). Background + Visibility are set per copy;
             this carries the thickness, opacity and top/bottom/stretch positioning common to both. -->
        <Style x:Key="StripPreviewSwatch" TargetType="Border">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Opacity" Value="{Binding EffectiveStripOpacity}"/>
            <Setter Property="Height" Value="{Binding StripThicknessPixels}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StripVerticalPosition}" Value="bottom">
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StripFillsTaskbar}" Value="True">
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Per-language color row templates =====
             The caret/mouse/strip color tables are card lists (one row per language) rather than
             DataGrids, so the color swatches open the picker on a single click. The delete button
             binds its Command from the hosting ItemsControl's Tag, which lets the caret and mouse
             lists share ONE template while each supplies its own Remove*ColorCommand. -->

        <!-- Caret / mouse label row: background + text + border swatches, border width, live chip. -->
        <DataTemplate x:Key="LabelColorRow">
            <Border Background="#06000000" BorderBrush="#10000000" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Language identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#11000000" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11" Foreground="#FF374151"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code, Converter={StaticResource LangName}}"
                                       FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Code, Converter={StaticResource LangName}, ConverterParameter=english}"
                                       FontSize="11" Foreground="{DynamicResource SubtleText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Swatches -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Width="52" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T Label_Swatch_Background}" FontSize="9.5"
                                       Foreground="{DynamicResource SubtleText}" Margin="2,0,0,2" TextTrimming="CharacterEllipsis"/>
                            <ctrl:ColorPickerButton SelectedColor="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="52" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T Label_Swatch_Text}" FontSize="9.5"
                                       Foreground="{DynamicResource SubtleText}" Margin="2,0,0,2" TextTrimming="CharacterEllipsis"/>
                            <ctrl:ColorPickerButton SelectedColor="{Binding Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="52">
                            <TextBlock Text="{loc:T Label_Swatch_Border}" FontSize="9.5"
                                       Foreground="{DynamicResource SubtleText}" Margin="2,0,0,2" TextTrimming="CharacterEllipsis"/>
                            <ctrl:ColorPickerButton SelectedColor="{Binding BorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Border width -->
                    <StackPanel Grid.Column="3" Width="84" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Label_Swatch_Width}" FontSize="9.5"
                                   Foreground="{DynamicResource SubtleText}" Margin="2,0,0,2" TextTrimming="CharacterEllipsis"/>
                        <ui:NumberBox Value="{Binding BorderThickness, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="0" Maximum="20" SmallChange="1"/>
                    </StackPanel>

                    <!-- Live chip preview. Background/BorderBrush/Foreground are hex strings on the
                         row (a DataContext binding), where WPF's implicit string→Brush conversion
                         works reliably — so no converter is needed here. -->
                    <Border Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center"
                            CornerRadius="3" MinWidth="46" Height="26" Padding="6,1"
                            Background="{Binding Background}"
                            BorderBrush="{Binding BorderColor}"
                            BorderThickness="{Binding BorderThicknessUniform}">
                        <TextBlock Text="Aא" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground}"/>
                    </Border>

                    <!-- Delete (command comes from the hosting ItemsControl's Tag) -->
                    <ui:Button Grid.Column="5" Appearance="Secondary" Padding="6,2" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{loc:T Strip_Remove_Tooltip}"
                               Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Delete20"/>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Taskbar-strip row: a single color swatch per language. -->
        <DataTemplate x:Key="StripColorRow">
            <Border Background="#06000000" BorderBrush="#10000000" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#11000000" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11" Foreground="#FF374151"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Code, Converter={StaticResource LangName}}"
                                       FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Code, Converter={StaticResource LangName}, ConverterParameter=english}"
                                       FontSize="11" Foreground="{DynamicResource SubtleText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Strip_Column_Color}" FontSize="9.5"
                                   Foreground="{DynamicResource SubtleText}" Margin="2,0,0,2"/>
                        <ctrl:ColorPickerButton SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="3" Appearance="Secondary" Padding="6,2" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{loc:T Strip_Remove_Tooltip}"
                               Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Delete20"/>
                    </ui:Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <ui:TitleBar Grid.Row="0"
                     Title="{loc:T Window_Title}"
                     ShowMaximize="False"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo-64.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===== Sidebar + content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#08000000" BorderBrush="#15000000" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="16,4,16,18">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Nav_AppName}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentText}"/>
                            <TextBlock Text="{loc:T Nav_Subtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleText}"/>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="NavCaret" Style="{StaticResource NavItem}" IsChecked="True"
                                 ToolTip="{loc:T Nav_CaretLabel_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TextField20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T Nav_CaretLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMouse" Style="{StaticResource NavItem}"
                                 ToolTip="{loc:T Nav_MouseLabel_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CursorClick20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T Nav_MouseLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavStrip" Style="{StaticResource NavItem}"
                                 ToolTip="{loc:T Nav_TaskbarStrip_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Color20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T Nav_TaskbarStrip}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavIdle" Style="{StaticResource NavItem}"
                                 ToolTip="{loc:T Nav_IdleReset_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T Nav_IdleReset}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}"
                                 ToolTip="{loc:T Nav_General_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T Nav_General}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Pages -->
            <Grid Grid.Column="1">

                <!-- ===== Caret label page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavCaret, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Caret_Title}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="{loc:T Caret_Subtitle}"/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Caret_PreviewLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <!-- FlowDirection pinned LTR: this mock document/caret must not mirror
                                     when the settings UI is in a RTL language (e.g. Hebrew). -->
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16" Height="120">
                                    <Canvas ClipToBounds="True" FlowDirection="LeftToRight">
                                        <Rectangle Canvas.Left="0" Canvas.Top="16"
                                                   Width="420" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="42"
                                                   Width="320" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="68"
                                                   Width="220" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <!-- Caret (centre at 231,43) -->
                                        <Rectangle x:Name="DemoCaret"
                                                   Canvas.Left="230" Canvas.Top="34"
                                                   Width="2" Height="18" Fill="{DynamicResource DocCaret}"/>
                                        <!-- Label anchored by its CENTRE on the caret centre, then shifted by
                                             the user offset — mirrors the live overlay. The first translate
                                             (-ActualSize/2) centres the chip; the second applies the offset. -->
                                        <Border x:Name="CaretChip" CornerRadius="3" Padding="4,1"
                                                Canvas.Left="231" Canvas.Top="43"
                                                Background="{Binding CaretPreviewBackground}"
                                                BorderBrush="{Binding CaretPreviewBorderBrush}"
                                                BorderThickness="{Binding CaretPreviewBorderThickness}"
                                                Opacity="{Binding CaretPreviewOpacity}">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <!-- Centre vertically on the caret (X centring is folded into the
                                                         mode-aware converter below). The size bindings target the chip
                                                         by name: RelativeSource Self on a Transform resolves to the
                                                         Transform (no ActualWidth/Height), silently collapsing the
                                                         centring to 0 — ElementName reaches the Border instead. -->
                                                    <TranslateTransform Y="{Binding ActualHeight, ElementName=CaretChip, Converter={StaticResource HalfNegate}}"/>
                                                    <!-- Apply the user offset: X per horizontal mode, Y positive-up. -->
                                                    <TranslateTransform Y="{Binding CaretPreviewOffsetY}">
                                                        <TranslateTransform.X>
                                                            <MultiBinding Converter="{StaticResource CaretPreviewX}">
                                                                <Binding Path="CaretHorizontalAuto"/>
                                                                <Binding Path="ActualWidth" ElementName="CaretChip"/>
                                                                <Binding Path="CaretPreviewOffsetX"/>
                                                            </MultiBinding>
                                                        </TranslateTransform.X>
                                                    </TranslateTransform>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding CaretPreviewCode}"
                                                       Foreground="{Binding CaretPreviewForeground}"
                                                       FontWeight="{Binding CaretPreviewFontWeight}"
                                                       FontFamily="{Binding CaretFont}"
                                                       FontSize="{Binding CaretSize}"
                                                       Opacity="{Binding CaretPreviewTextOpacity}"/>
                                        </Border>
                                    </Canvas>
                                </Border>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Caret_PreviewHint}"/>
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="{loc:T Caret_Enable}"
                                                 IsChecked="{Binding CaretEnabled}"
                                                 ToolTip="{loc:T Caret_Enable_Tooltip}"/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding CaretEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Horizontal-mode selector on its own full-width row. Keeping the radios
                                         out of the offset columns lets the two NumberBoxes below line up on a
                                         shared row instead of the X box being pushed down by the radios. -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" Text="{loc:T Caret_Horizontal}"/>
                                        <RadioButton GroupName="CaretHorizontal" VerticalAlignment="Center"
                                                     Content="{loc:T Caret_Horizontal_Manual}"
                                                     IsChecked="{Binding CaretHorizontalManual, Mode=TwoWay}"
                                                     ToolTip="{loc:T Caret_Horizontal_Manual_Tooltip}"/>
                                        <RadioButton GroupName="CaretHorizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                                     Content="{loc:T Caret_Horizontal_Auto}"
                                                     IsChecked="{Binding CaretHorizontalAuto, Mode=TwoWay}"
                                                     ToolTip="{loc:T Caret_Horizontal_Auto_Tooltip}"/>
                                    </StackPanel>

                                    <!-- Horizontal value: a signed offset in manual mode, a non-negative
                                         distance in auto mode (only one NumberBox is visible at a time). -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Caret_OffsetX}"/>
                                        <ui:NumberBox Value="{Binding CaretOffsetX, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      Visibility="{Binding CaretHorizontalManual, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="{loc:T Caret_OffsetX_Tooltip}"/>
                                        <ui:NumberBox Value="{Binding CaretHorizontalDistance, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="400" SmallChange="1" LargeChange="5"
                                                      Visibility="{Binding CaretHorizontalAuto, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="{loc:T Caret_Horizontal_Auto_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Caret_OffsetY}"/>
                                        <ui:NumberBox Value="{Binding CaretOffsetY, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="{loc:T Caret_OffsetY_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Caret_Opacity}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding CaretOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:T Caret_Opacity_Tooltip}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding CaretOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Typography: font family / size / weight / text opacity in their own section -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding CaretEnabled}">
                                <TextBlock Text="{loc:T Label_TypographyTitle}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Label_TypographyHint}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Caret_FontFamily}"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  Text="{Binding CaretFont, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="{loc:T Caret_FontFamily_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Caret_FontSize}"/>
                                        <ui:NumberBox Value="{Binding CaretSize, UpdateSourceTrigger=PropertyChanged}" Minimum="6" Maximum="72" SmallChange="1" LargeChange="2"
                                                      ToolTip="{loc:T Caret_FontSize_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Label_FontWeight}"/>
                                        <ComboBox ItemsSource="{Binding FontWeightOptions}"
                                                  SelectedItem="{Binding CaretFontWeight}"
                                                  ToolTip="{loc:T Label_FontWeight_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Label_TextOpacity}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding CaretTextOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:T Label_TextOpacity_Tooltip}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding CaretTextOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="{loc:T Label_TextOpacity_Hint}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-language color list -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding CaretEnabled}">
                                <TextBlock Text="{loc:T Label_ColorTableTitle}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Label_ColorTableHint}"/>

                                <ItemsControl ItemsSource="{Binding CaretColorRows}"
                                              ItemTemplate="{StaticResource LabelColorRow}"
                                              Tag="{Binding RemoveCaretColorCommand}"
                                              Margin="0,12,0,4"/>

                                <StackPanel Orientation="Horizontal">
                                    <ctrl:LanguageAddButton ItemsSource="{Binding LanguageOptions}"
                                                            SelectCommand="{Binding AddCaretColorCommand}"/>
                                    <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                                               Click="OnCopyCaretToMouse"
                                               IsEnabled="{Binding CaretHasColors}"
                                               ToolTip="{loc:T Label_CopyToMouse_Tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Copy20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:T Label_CopyToMouse}"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Mouse label page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavMouse, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Mouse_Title}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="{loc:T Mouse_Subtitle}"/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Mouse_PreviewLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <!-- FlowDirection pinned LTR: the mock cursor + label must not mirror
                                     when the settings UI is in a RTL language (e.g. Hebrew). -->
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16" Height="140">
                                    <Canvas ClipToBounds="True" FlowDirection="LeftToRight">
                                        <!-- Fake cursor arrow -->
                                        <Path Canvas.Left="200" Canvas.Top="40"
                                              Fill="White" Stroke="#FF111827" StrokeThickness="1.2"
                                              Data="M 0,0 L 0,18 L 5,14 L 8,21 L 11,20 L 8,13 L 14,13 Z"/>
                                        <!-- Label anchored on the cursor tip (200,40): horizontally CENTRED,
                                             vertically TOP-aligned (top edge at the tip when offset is 0), then
                                             shifted by the user offset — mirrors the live overlay. The first
                                             translate centres the chip horizontally (-ActualWidth/2 only). -->
                                        <Border x:Name="MouseChip" CornerRadius="3" Padding="4,1"
                                                Canvas.Left="200" Canvas.Top="40"
                                                Background="{Binding MousePreviewBackground}"
                                                BorderBrush="{Binding MousePreviewBorderBrush}"
                                                BorderThickness="{Binding MousePreviewBorderThickness}"
                                                Opacity="{Binding MousePreviewOpacity}">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <!-- Centre horizontally on the cursor hotspot. ElementName (not
                                                         RelativeSource Self, which on a Transform points at the Transform
                                                         and has no ActualWidth) so the centring actually applies. -->
                                                    <TranslateTransform X="{Binding ActualWidth, ElementName=MouseChip, Converter={StaticResource HalfNegate}}"/>
                                                    <TranslateTransform X="{Binding MouseOffsetX}" Y="{Binding MousePreviewOffsetY}"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding MousePreviewCode}"
                                                       Foreground="{Binding MousePreviewForeground}"
                                                       FontWeight="{Binding MousePreviewFontWeight}"
                                                       FontFamily="{Binding MouseFont}"
                                                       FontSize="{Binding MouseSize}"
                                                       Opacity="{Binding MousePreviewTextOpacity}"/>
                                        </Border>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="{loc:T Mouse_Enable}"
                                                 IsChecked="{Binding MouseEnabled}"
                                                 ToolTip="{loc:T Mouse_Enable_Tooltip}"/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding MouseEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_OffsetX}"/>
                                        <ui:NumberBox Value="{Binding MouseOffsetX, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="{loc:T Mouse_OffsetX_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_OffsetY}"/>
                                        <ui:NumberBox Value="{Binding MouseOffsetY, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="{loc:T Mouse_OffsetY_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_TrackingMode}"/>
                                        <ComboBox ItemsSource="{Binding MouseTrackingModes}"
                                                  SelectedItem="{Binding MouseTrackingMode}"
                                                  ToolTip="{loc:T Mouse_TrackingMode_Tooltip}"/>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="{loc:T Mouse_TrackingMode_Hint}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_Opacity}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding MouseOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:T Mouse_Opacity_Tooltip}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding MouseOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Typography: font family / size / weight / text opacity in their own section -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding MouseEnabled}">
                                <TextBlock Text="{loc:T Label_TypographyTitle}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Label_TypographyHint}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_FontFamily}"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  Text="{Binding MouseFont, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="{loc:T Mouse_FontFamily_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Mouse_FontSize}"/>
                                        <ui:NumberBox Value="{Binding MouseSize, UpdateSourceTrigger=PropertyChanged}" Minimum="6" Maximum="72" SmallChange="1" LargeChange="2"
                                                      ToolTip="{loc:T Mouse_FontSize_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Label_FontWeight}"/>
                                        <ComboBox ItemsSource="{Binding FontWeightOptions}"
                                                  SelectedItem="{Binding MouseFontWeight}"
                                                  ToolTip="{loc:T Label_FontWeight_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Label_TextOpacity}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding MouseTextOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:T Label_TextOpacity_Tooltip}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding MouseTextOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="{loc:T Label_TextOpacity_Hint}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-language color list -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding MouseEnabled}">
                                <TextBlock Text="{loc:T Label_ColorTableTitle}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Label_ColorTableHint}"/>

                                <ItemsControl ItemsSource="{Binding MouseColorRows}"
                                              ItemTemplate="{StaticResource LabelColorRow}"
                                              Tag="{Binding RemoveMouseColorCommand}"
                                              Margin="0,12,0,4"/>

                                <StackPanel Orientation="Horizontal">
                                    <ctrl:LanguageAddButton ItemsSource="{Binding LanguageOptions}"
                                                            SelectCommand="{Binding AddMouseColorCommand}"/>
                                    <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                                               Click="OnCopyMouseToCaret"
                                               IsEnabled="{Binding MouseHasColors}"
                                               ToolTip="{loc:T Label_CopyToCaret_Tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Copy20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:T Label_CopyToCaret}"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Taskbar strip page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavStrip, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Strip_Title}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="{loc:T Strip_Subtitle}"/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Strip_PreviewLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Height="160" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fake desktop area -->
                                        <Border Grid.Row="0" Background="#FFF1F5F9"/>

                                        <!-- Strip drawn BEHIND the taskbar — mirrors Placement='behind'. It sits between
                                             the desktop and the taskbar, so the translucent taskbar above tints/dims it.
                                             That bleed-through is the whole point of "behind", and it only looks like this
                                             when Windows Transparency effects are on (see the note below). Shown only while
                                             that case is being simulated. -->
                                        <Border Style="{StaticResource StripPreviewSwatch}"
                                                Background="{Binding PreviewColor}"
                                                Visibility="{Binding StripBehindSimulated, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Fake taskbar (Windows 11 style). Opaque by default; while simulating a
                                             'behind' strip it turns translucent so the swatch underneath shows through —
                                             i.e. the preview assumes Transparency effects are ON. -->
                                        <Border Grid.Row="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF1F2937"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StripBehindSimulated}" Value="True">
                                                            <Setter Property="Background" Value="#CC1F2937"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF60A5FA" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Strip drawn IN FRONT of the taskbar — mirrors Placement='front'. Crisp, full
                                             color over the icons. Shown only while that case is being simulated. -->
                                        <Border Style="{StaticResource StripPreviewSwatch}"
                                                Background="{Binding PreviewColor}"
                                                Visibility="{Binding StripFrontSimulated, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Strip_PreviewHint}"/>
                                <!-- Only relevant while simulating 'behind': the bleed-through assumes Transparency
                                     effects are enabled. Hidden in 'front' mode, where z-order doesn't depend on it. -->
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Strip_PreviewTransparencyNote}"
                                           Visibility="{Binding StripBehindSimulated, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="{loc:T Strip_Enable}"
                                                 IsChecked="{Binding StripEnabled}"
                                                 ToolTip="{loc:T Strip_Enable_Tooltip}"/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding StripEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Strip_Thickness}"/>
                                        <ComboBox ItemsSource="{Binding StripThicknesses}"
                                                  SelectedItem="{Binding StripThickness}"
                                                  ToolTip="{loc:T Strip_Thickness_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Strip_VerticalPosition}"/>
                                        <ComboBox ItemsSource="{Binding StripVerticalPositions}"
                                                  SelectedItem="{Binding StripVerticalPosition}"
                                                  IsEnabled="{Binding StripVerticalPositionEnabled}"
                                                  ToolTip="{loc:T Strip_VerticalPosition_Tooltip}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Strip_ZOrder}"/>
                                        <ComboBox ItemsSource="{Binding StripPlacements}"
                                                  SelectedItem="{Binding StripPlacement}"
                                                  ToolTip="{loc:T Strip_ZOrder_Tooltip}"/>
                                    </StackPanel>

                                    <ui:ToggleSwitch Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                     Margin="0,18,0,0"
                                                     Content="{loc:T Strip_ApplyTransparency}"
                                                     IsChecked="{Binding StripOpacityEnabled}"
                                                     ToolTip="{loc:T Strip_ApplyTransparency_Tooltip}"/>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                                IsEnabled="{Binding StripOpacityEnabled}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Strip_Opacity}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding StripOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:T Strip_Opacity_Tooltip}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding StripOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Color list -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding StripEnabled}">
                                <TextBlock Text="{loc:T Strip_ColorTableTitle}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T Strip_ColorTableHint}"/>

                                <ItemsControl ItemsSource="{Binding ColorRows}"
                                              ItemTemplate="{StaticResource StripColorRow}"
                                              Tag="{Binding RemoveColorCommand}"
                                              Margin="0,12,0,4"/>

                                <ctrl:LanguageAddButton HorizontalAlignment="Left"
                                                        ItemsSource="{Binding LanguageOptions}"
                                                        SelectCommand="{Binding AddColorCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Idle reset page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavIdle, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T Idle_Title}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="{loc:T Idle_Subtitle}"/>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Idle_PreviewLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="#FF1F2937" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Timer20" FontSize="28" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:T Idle_PreviewAfter}" VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="{Binding IdleSeconds}" FontWeight="SemiBold" FontSize="14" Foreground="#FF2563EB" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:T Idle_PreviewSecondsIdle}" VerticalAlignment="Center" FontSize="14"/>
                                                <!-- Idle preview keeps the RTL flow of the active UI language;
                                                     the arrow glyph itself must point the reading direction, so
                                                     it flips to a left-arrow when the UI is right-to-left. -->
                                                <ui:SymbolIcon Margin="6,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="ArrowRight20"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRtl}" Value="True">
                                                                    <Setter Property="Symbol" Value="ArrowLeft20"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{loc:T Idle_PreviewSwitchTo}" VerticalAlignment="Center" FontSize="14"/>
                                                <Border Background="#FF1F2937" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding IdleTarget}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}"
                                                       Margin="0,6,0,0"
                                                       Text="{loc:T Idle_PreviewHint}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="{loc:T Idle_Enable}"
                                                 IsChecked="{Binding IdleEnabled}"
                                                 ToolTip="{loc:T Idle_Enable_Tooltip}"/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding IdleEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Idle_Seconds}"/>
                                        <ui:NumberBox Value="{Binding IdleSeconds, UpdateSourceTrigger=PropertyChanged}" Minimum="5" Maximum="3600" SmallChange="5" LargeChange="30"
                                                      ToolTip="{loc:T Idle_Seconds_Tooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T Idle_Target}"/>
                                        <ComboBox ItemsSource="{Binding AvailableCodes}"
                                                  Text="{Binding IdleTarget, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="{loc:T Idle_Target_Tooltip}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== General page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavGeneral, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:T General_Title}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="{loc:T General_Subtitle}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="{loc:T General_LaunchOnStartup}"
                                                 IsChecked="{Binding Autostart}"
                                                 ToolTip="{loc:T General_LaunchOnStartup_Tooltip}"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T General_TrayHint}"/>
                            </StackPanel>
                        </Border>

                        <!-- In-app guide for removing the Windows taskbar language indicator.
                             Instructions only — Windows doesn't let an app do these steps reliably. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T HideLangBar_Title}"/>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           Text="{loc:T HideLangBar_Intro}" Margin="0,4,0,10"/>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           Text="{loc:T HideLangBar_Step1}" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           Text="{loc:T HideLangBar_Step2}" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           Text="{loc:T HideLangBar_Step3}" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           Text="{loc:T HideLangBar_Note}"/>
                            </StackPanel>
                        </Border>

                        <!-- Language picker: ItemsSource is populated dynamically from JSON files
                             discovered under Languages\, so adding a new file ⇒ new combo entry. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T General_Language}"/>
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          ToolTip="{loc:T General_Language_Tooltip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NativeName}" FontWeight="SemiBold"/>
                                                <TextBlock Text=" — " Opacity="0.6"/>
                                                <TextBlock Text="{Binding Name}" Opacity="0.8"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="{loc:T General_Language_Hint}"/>
                            </StackPanel>
                        </Border>

                        <!-- About: version + copyright are bound to assembly metadata (see
                             SettingsViewModel.AppVersion / AppCopyright), so they track the
                             .csproj <Version>/<Copyright> automatically. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T About_Title}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Image Source="pack://application:,,,/Assets/logo.png"
                                           Width="40" Height="40"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="OopsType"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentText}"/>
                                            <TextBlock Text="{loc:T About_Version}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource SubtleText}"/>
                                            <TextBlock Text="{Binding AppVersion}"
                                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource SubtleText}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppCopyright}"
                                                   FontSize="12" Foreground="{DynamicResource SubtleText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="12">
                                    <Hyperlink NavigateUri="https://github.com/ori-halevi/OopsType"
                                               RequestNavigate="OnRequestNavigate">
                                        <Run Text="{loc:T About_Repository}"/>
                                    </Hyperlink>
                                    <Run Text="   ·   " Foreground="{DynamicResource SubtleText}"/>
                                    <Run Text="{loc:T About_License}" Foreground="{DynamicResource SubtleText}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Background="#08000000" BorderBrush="#15000000" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Fill" Value="#FFF59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleText}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:T Footer_AllSaved}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Text" Value="{loc:T Footer_Unsaved}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               MinWidth="120"
                               Command="{Binding DiscardCommand}"
                               ToolTip="{loc:T Footer_Discard_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUndo20" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:T Footer_Discard}"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Primary"
                               MinWidth="120"
                               Margin="10,0,0,0"
                               Command="{Binding SaveCommand}"
                               IsDefault="True"
                               ToolTip="{loc:T Footer_Save_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:T Footer_Save}"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
