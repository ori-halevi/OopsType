<ui:FluentWindow x:Class="OopsType.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="OopsType — Settings"
        Width="980" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FlowDirection="LeftToRight">

    <Window.Resources>
        <!-- ===== Tokens ===== -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" Opacity="0.65"/>
        <SolidColorBrush x:Key="CardBorder" Color="#22000000"/>
        <SolidColorBrush x:Key="SubtleText" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="AccentText" Color="#FF1F2937"/>
        <SolidColorBrush x:Key="PreviewBackground" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="PreviewSurface" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PreviewBorder" Color="#FFE5E7EB"/>
        <SolidColorBrush x:Key="DocLine" Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="DocCaret" Color="#FF111827"/>

        <!-- ===== Common card style ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Sidebar nav button -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Accent" Grid.Column="0"
                                           Width="4" RadiusX="2" RadiusY="2"
                                           Fill="Transparent"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Stretch"
                                           Margin="-10,4,0,4"/>
                                <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#11000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2563EB"/>
                                <Setter TargetName="Accent" Property="Fill" Value="#FF2563EB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#FF1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page visibility: collapse a page when its tag != selected nav's tag -->
        <Style x:Key="PageRoot" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="32,24,32,24"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <ui:TitleBar Grid.Row="0"
                     Title="OopsType — Settings"
                     ShowMaximize="False"
                     ShowMinimize="True"/>

        <!-- ===== Sidebar + content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#08000000" BorderBrush="#15000000" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="OopsType"
                               FontSize="18" FontWeight="SemiBold"
                               Margin="20,4,0,2"
                               Foreground="{DynamicResource AccentText}"/>
                    <TextBlock Text="Keyboard-layout overlays"
                               FontSize="11" Margin="20,0,0,18"
                               Foreground="{DynamicResource SubtleText}"/>

                    <RadioButton x:Name="NavCaret" Style="{StaticResource NavItem}" IsChecked="True"
                                 ToolTip="Settings for the small language label that follows your text caret">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TextField20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Caret label" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMouse" Style="{StaticResource NavItem}"
                                 ToolTip="Settings for the language label that follows your mouse cursor">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CursorClick20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Mouse label" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavStrip" Style="{StaticResource NavItem}"
                                 ToolTip="Settings for the colored strip drawn over your taskbar to indicate the active layout">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Color20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Taskbar strip" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavIdle" Style="{StaticResource NavItem}"
                                 ToolTip="Auto-switch the layout back to a target language when the keyboard has been idle for some time">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Idle reset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}"
                                 ToolTip="General application settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Pages -->
            <Grid Grid.Column="1">

                <!-- ===== Caret label page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavCaret, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Caret label"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="A small floating label that follows your text caret and shows the active keyboard layout. Useful while typing in mixed-language documents."/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="Live preview"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16" Height="120">
                                    <Canvas ClipToBounds="True">
                                        <Rectangle Canvas.Left="0" Canvas.Top="16"
                                                   Width="420" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="42"
                                                   Width="320" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="68"
                                                   Width="220" Height="2" Fill="{DynamicResource DocLine}"/>
                                        <!-- Caret -->
                                        <Rectangle x:Name="DemoCaret"
                                                   Canvas.Left="230" Canvas.Top="34"
                                                   Width="2" Height="18" Fill="{DynamicResource DocCaret}"/>
                                        <!-- Label, offset relative to caret -->
                                        <Border Background="#CC222222" CornerRadius="3" Padding="4,1"
                                                Canvas.Left="232" Canvas.Top="34">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding CaretOffsetX}" Y="{Binding CaretOffsetY}"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding PreviewCode}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{Binding CaretFont}"
                                                       FontSize="{Binding CaretSize}"/>
                                        </Border>
                                    </Canvas>
                                </Border>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="The label uses the language code from your first configured row, or 'EN' if none exists yet."/>
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="Enable the caret label"
                                                 IsChecked="{Binding CaretEnabled}"
                                                 ToolTip="Master switch for the caret label overlay."/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding CaretEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Horizontal offset (px)"/>
                                        <ui:NumberBox Value="{Binding CaretOffsetX, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="Pixels to shift the label to the right of the caret. Negative values move it to the left."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vertical offset (px)"/>
                                        <ui:NumberBox Value="{Binding CaretOffsetY, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="Pixels to shift the label downward from the caret. Negative values move it up."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font family"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  Text="{Binding CaretFont, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="Font family used to draw the label. Type to search; defaults to a system font if the chosen family is unavailable."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font size (pt)"/>
                                        <ui:NumberBox Value="{Binding CaretSize, UpdateSourceTrigger=PropertyChanged}" Minimum="6" Maximum="72" SmallChange="1" LargeChange="2"
                                                      ToolTip="Font size of the label in points. Larger sizes are more visible but more intrusive."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Mouse label page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavMouse, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Mouse label"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="A small label that follows your mouse cursor and shows the active keyboard layout. Handy in apps without a visible text caret."/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="Live preview"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16" Height="140">
                                    <Canvas ClipToBounds="True">
                                        <!-- Fake cursor arrow -->
                                        <Path Canvas.Left="200" Canvas.Top="40"
                                              Fill="White" Stroke="#FF111827" StrokeThickness="1.2"
                                              Data="M 0,0 L 0,18 L 5,14 L 8,21 L 11,20 L 8,13 L 14,13 Z"/>
                                        <!-- Label offset from cursor tip -->
                                        <Border Background="#CC222222" CornerRadius="3" Padding="4,1"
                                                Canvas.Left="200" Canvas.Top="40">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding MouseOffsetX}" Y="{Binding MouseOffsetY}"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding PreviewCode}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{Binding MouseFont}"
                                                       FontSize="{Binding MouseSize}"/>
                                        </Border>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="Enable the mouse label"
                                                 IsChecked="{Binding MouseEnabled}"
                                                 ToolTip="Master switch for the mouse cursor label overlay."/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding MouseEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Horizontal offset (px)"/>
                                        <ui:NumberBox Value="{Binding MouseOffsetX, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="Pixels to shift the label to the right of the cursor tip. Negative values move it left."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vertical offset (px)"/>
                                        <ui:NumberBox Value="{Binding MouseOffsetY, UpdateSourceTrigger=PropertyChanged}" Minimum="-200" Maximum="400" SmallChange="1" LargeChange="5"
                                                      ToolTip="Pixels to shift the label downward from the cursor tip. Negative values move it up."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font family"/>
                                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                                  Text="{Binding MouseFont, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="Font family used to draw the label."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font size (pt)"/>
                                        <ui:NumberBox Value="{Binding MouseSize, UpdateSourceTrigger=PropertyChanged}" Minimum="6" Maximum="72" SmallChange="1" LargeChange="2"
                                                      ToolTip="Font size of the label in points."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tracking mode"/>
                                        <ComboBox ItemsSource="{Binding MouseTrackingModes}"
                                                  SelectedItem="{Binding MouseTrackingMode}"
                                                  ToolTip="Economy: the label only updates while the mouse moves; idle when at rest. Max-smoothness: marginally snappier first-frame response at higher background CPU/battery cost."/>
                                        <TextBlock Style="{StaticResource FieldHint}"
                                                   Text="Economy is recommended for laptops. Max-smoothness shaves a few milliseconds at the cost of constant background polling."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Taskbar strip page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavStrip, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Taskbar color strip"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="A colored strip drawn over your taskbar, in the color you assigned to the active language. Glanceable from across the screen."/>

                        <!-- Live preview -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="Live preview"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Height="160" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fake desktop area -->
                                        <Border Grid.Row="0" Background="#FFF1F5F9"/>

                                        <!-- Fake taskbar (Windows 11 style) -->
                                        <Border Grid.Row="1" Background="#FF1F2937">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF60A5FA" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FF94A3B8" Margin="3,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Strip overlay: position controlled by VerticalPosition + thickness -->
                                        <Border Grid.Row="1"
                                                Background="{Binding PreviewColor}"
                                                Opacity="{Binding EffectiveStripOpacity}"
                                                Height="{Binding StripThicknessPixels}"
                                                Visibility="{Binding StripEnabled, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StripVerticalPosition}" Value="bottom">
                                                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StripFillsTaskbar}" Value="True">
                                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Preview uses the first configured color row. Add languages below to see the strip switch colors when the layout changes."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="Enable the taskbar strip"
                                                 IsChecked="{Binding StripEnabled}"
                                                 ToolTip="Master switch for the taskbar color-strip overlay."/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding StripEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thickness"/>
                                        <ComboBox ItemsSource="{Binding StripThicknesses}"
                                                  SelectedItem="{Binding StripThickness}"
                                                  ToolTip="How tall the strip is. 'Full' covers the entire taskbar height and disables the vertical position option."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vertical position"/>
                                        <ComboBox ItemsSource="{Binding StripVerticalPositions}"
                                                  SelectedItem="{Binding StripVerticalPosition}"
                                                  IsEnabled="{Binding StripVerticalPositionEnabled}"
                                                  ToolTip="Whether the strip sits at the top or bottom of the taskbar. Disabled when thickness is 'full'."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Z-order placement"/>
                                        <ComboBox ItemsSource="{Binding StripPlacements}"
                                                  SelectedItem="{Binding StripPlacement}"
                                                  ToolTip="'Front': strip is drawn over taskbar icons (best visibility). 'Behind': strip is drawn under icons (subtler, but harder to see when icons overlap)."/>
                                    </StackPanel>

                                    <ui:ToggleSwitch Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                     Margin="0,18,0,0"
                                                     Content="Apply transparency"
                                                     IsChecked="{Binding StripOpacityEnabled}"
                                                     ToolTip="When on, the strip is drawn with the opacity below. When off, it is fully opaque."/>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                                IsEnabled="{Binding StripOpacityEnabled}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0" Maximum="1"
                                                    SmallChange="0.05" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                    Value="{Binding StripOpacity}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="0% is fully transparent, 100% is fully opaque."/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding StripOpacity, StringFormat={}{0:P0}}"
                                                       Foreground="{DynamicResource SubtleText}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Color table -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding StripEnabled}">
                                <TextBlock Text="Language colors"
                                           FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Map each installed keyboard layout to a hex color (e.g. #FF0000). The strip shows the color for the currently active layout."/>

                                <DataGrid ItemsSource="{Binding ColorRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#11000000"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="#08000000"
                                          Height="180"
                                          Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Language code" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                        <DataGridTextColumn Header="Hex color" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTemplateColumn Header="Swatch" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Width="48" Height="20"
                                                            BorderBrush="#33000000" BorderThickness="1"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding Color}"
                                                            ToolTip="{Binding Color}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Appearance="Secondary"
                                                               Padding="6,2"
                                                               Margin="0,2"
                                                               ToolTip="Remove this row"
                                                               Command="{Binding DataContext.RemoveColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Delete20"/>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ui:Button Appearance="Primary"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding AddColorCommand}"
                                           ToolTip="Add a new language → color mapping">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add20" Margin="0,0,6,0"/>
                                        <TextBlock Text="Add language"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Idle reset page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavIdle, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Idle reset"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="Automatically switch the keyboard layout to a chosen target when the keyboard has been idle for a while. Prevents typing in the wrong layout after walking away."/>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource PreviewBackground}">
                            <StackPanel>
                                <TextBlock Text="Live preview"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleText}"
                                           Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource PreviewSurface}"
                                        BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="20,16">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="#FF1F2937" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Timer20" FontSize="28" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="After " VerticalAlignment="Center" FontSize="14"/>
                                                <TextBlock Text="{Binding IdleSeconds}" FontWeight="SemiBold" FontSize="14" Foreground="#FF2563EB" VerticalAlignment="Center"/>
                                                <TextBlock Text=" seconds idle " VerticalAlignment="Center" FontSize="14"/>
                                                <ui:SymbolIcon Symbol="ArrowRight20" Margin="6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="switch to " VerticalAlignment="Center" FontSize="14"/>
                                                <Border Background="#FF1F2937" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding IdleTarget}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}"
                                                       Margin="0,6,0,0"
                                                       Text="Triggered only when the keyboard is idle — mouse movement does not reset the timer."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="Enable idle reset"
                                                 IsChecked="{Binding IdleEnabled}"
                                                 ToolTip="Master switch for automatically resetting the layout after idle time."/>

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding IdleEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Idle seconds"/>
                                        <ui:NumberBox Value="{Binding IdleSeconds, UpdateSourceTrigger=PropertyChanged}" Minimum="5" Maximum="3600" SmallChange="5" LargeChange="30"
                                                      ToolTip="How long the keyboard must be idle before resetting. Minimum 5 seconds."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Target language"/>
                                        <ComboBox ItemsSource="{Binding AvailableCodes}"
                                                  Text="{Binding IdleTarget, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="Two-letter language code the layout will reset to (e.g. 'en', 'he', 'ru')."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== General page ===== -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageRoot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NavGeneral, Path=IsChecked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="General"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}"
                                   Text="Application-wide options."/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:ToggleSwitch Content="Launch on Windows startup"
                                                 IsChecked="{Binding Autostart}"
                                                 ToolTip="Adds OopsType to the Windows Run registry so it starts in the background when you sign in."/>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="OopsType runs in the system tray. Right-click the tray icon to open this window or quit."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Background="#08000000" BorderBrush="#15000000" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Fill" Value="#FFF59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleText}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="All changes saved"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Text" Value="Unsaved changes"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Appearance="Primary"
                           MinWidth="120"
                           Command="{Binding SaveCommand}"
                           IsDefault="True"
                           ToolTip="Persist current settings to disk and apply them to the running overlays.">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save20" Margin="0,0,6,0"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
