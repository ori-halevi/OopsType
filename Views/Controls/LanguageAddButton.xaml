<UserControl x:Class="OopsType.Views.Controls.LanguageAddButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OopsType.Markup"
             x:Name="Root">

    <Grid>
        <ui:Button x:Name="TriggerButton"
                   Appearance="Primary"
                   Click="OnOpen"
                   ToolTip="{loc:T Strip_AddLanguage_Tooltip}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Add20" Margin="0,0,6,0"/>
                <TextBlock Text="{loc:T Strip_AddLanguage}"/>
            </StackPanel>
        </ui:Button>

        <Popup x:Name="Popup"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=TriggerButton}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               VerticalOffset="4">
            <Border Background="#FFFFFFFF" CornerRadius="10" Padding="10"
                    BorderBrush="#22000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel Width="300">
                    <ui:TextBox x:Name="SearchBox"
                                Margin="0,0,0,8"
                                PlaceholderText="{loc:T Lang_SearchPlaceholder}"
                                TextChanged="OnSearchChanged">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search20"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- ListBox (not a bare ItemsControl in a ScrollViewer) so the ~280-entry
                         catalog VIRTUALIZES: only the visible rows are realized, making the popup
                         open instantly instead of building every row up front. IsVirtualizingWhenGrouping
                         keeps virtualization on despite the installed/all grouping. -->
                    <ListBox x:Name="List"
                             MaxHeight="320"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <!-- Strip the default ListBoxItem chrome (selection highlight, padding) so
                             the inner button template is the only visual; the button still drives
                             the pick via OnChoose. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#FF6B7280"
                                                   Margin="6,8,6,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnChoose" Tag="{Binding Code}"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand" Margin="0,1" Padding="8,6">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding NativeName}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding EnglishName}" FontSize="11" Foreground="#FF6B7280"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#1A10B981" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisCollapsed}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="#FF059669" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{loc:T Lang_InstalledBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF059669"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#11000000" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="11" Foreground="#FF374151"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#142563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint"
                               Text="{loc:T Lang_NoResults}"
                               FontSize="12" Foreground="#FF6B7280"
                               HorizontalAlignment="Center" Margin="0,12"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
