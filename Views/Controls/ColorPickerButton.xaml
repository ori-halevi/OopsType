<UserControl x:Class="OopsType.Views.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OopsType.Markup"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Checkerboard shown behind any partially-transparent color so the alpha is actually
             visible (a 50%-alpha chip over white looks identical to a lighter opaque color). -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Stretch="None"
                      Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,12,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD0D5DD">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,6,6"/>
                                <RectangleGeometry Rect="6,6,6,6"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <!-- The swatch button is all that shows in a row; clicking it opens the picker popup. The
         swatch sits over a checkerboard so transparency reads correctly. -->
    <Grid>
        <Button x:Name="SwatchButton"
                Click="OnOpen"
                Padding="3" Height="28"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Cursor="Hand"
                ToolTip="{Binding SelectedColor, ElementName=Root}">
            <!-- MinWidth/MinHeight guard against the themed Button's content presenter sizing the
                 swatch to its (empty) content — without a floor the colored fill collapses to 0. -->
            <Grid MinWidth="36" MinHeight="16">
                <Rectangle RadiusX="3" RadiusY="3" Fill="{StaticResource Checker}"/>
                <Border CornerRadius="3"
                        BorderBrush="#33000000" BorderThickness="1"
                        Background="{Binding SelectedBrush, ElementName=Root}"/>
            </Grid>
        </Button>

        <Popup x:Name="Popup"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="0" VerticalOffset="4">
            <Border Background="#FFFFFFFF" CornerRadius="10" Padding="14"
                    BorderBrush="#22000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel Width="240">

                    <!-- Saturation / brightness field. The base hue layer is set in code; the two
                         gradient layers turn it into the familiar SV square. -->
                    <Border x:Name="SvBox" Width="240" Height="150" CornerRadius="6"
                            ClipToBounds="True" Cursor="Cross"
                            MouseLeftButtonDown="OnBarDown" MouseMove="OnBarMove" MouseLeftButtonUp="OnBarUp">
                        <Grid>
                            <Border x:Name="SvHue"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000"/>
                                        <GradientStop Offset="1" Color="#FF000000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SvThumb" Width="14" Height="14" CornerRadius="7"
                                        BorderBrush="White" BorderThickness="2" Background="#01000000">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#80000000" BlurRadius="3" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Hue slider -->
                    <Border x:Name="HueBar" Width="240" Height="16" CornerRadius="4" Margin="0,12,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnBarDown" MouseMove="OnBarMove" MouseLeftButtonUp="OnBarUp">
                        <Grid>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.00" Color="#FFFF0000"/>
                                        <GradientStop Offset="0.17" Color="#FFFFFF00"/>
                                        <GradientStop Offset="0.33" Color="#FF00FF00"/>
                                        <GradientStop Offset="0.50" Color="#FF00FFFF"/>
                                        <GradientStop Offset="0.67" Color="#FF0000FF"/>
                                        <GradientStop Offset="0.83" Color="#FFFF00FF"/>
                                        <GradientStop Offset="1.00" Color="#FFFF0000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HueThumb" Width="7" Height="16" CornerRadius="3"
                                        BorderBrush="White" BorderThickness="2" Background="#01000000">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#80000000" BlurRadius="3" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Alpha slider (over the checkerboard so transparency is visible) -->
                    <Border x:Name="AlphaBar" Width="240" Height="16" CornerRadius="4" Margin="0,10,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnBarDown" MouseMove="OnBarMove" MouseLeftButtonUp="OnBarUp">
                        <Grid>
                            <Rectangle RadiusX="4" RadiusY="4" Fill="{StaticResource Checker}"/>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="AlphaStop0" Offset="0" Color="#00000000"/>
                                        <GradientStop x:Name="AlphaStop1" Offset="1" Color="#FF000000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="AlphaThumb" Width="7" Height="16" CornerRadius="3"
                                        BorderBrush="White" BorderThickness="2" Background="#01000000">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#80000000" BlurRadius="3" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Hex entry + live preview -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="HexBox"
                                    TextChanged="OnHexChanged"
                                    MaxLength="9"
                                    PlaceholderText="#AARRGGBB"
                                    FontFamily="Consolas"/>
                        <Grid Grid.Column="2">
                            <Rectangle RadiusX="4" RadiusY="4" Fill="{StaticResource Checker}"/>
                            <Border x:Name="PreviewSwatch" CornerRadius="4"
                                    BorderBrush="#33000000" BorderThickness="1"/>
                        </Grid>
                    </Grid>

                    <!-- R / G / B numeric entry -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Grid Margin="0,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" VerticalAlignment="Center" FontSize="12" Foreground="#FF6B7280"/>
                            <ui:TextBox Grid.Column="1" x:Name="RBox" TextChanged="OnRgbChanged" MaxLength="3"/>
                        </Grid>
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" VerticalAlignment="Center" FontSize="12" Foreground="#FF6B7280"/>
                            <ui:TextBox Grid.Column="1" x:Name="GBox" TextChanged="OnRgbChanged" MaxLength="3"/>
                        </Grid>
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" VerticalAlignment="Center" FontSize="12" Foreground="#FF6B7280"/>
                            <ui:TextBox Grid.Column="1" x:Name="BBox" TextChanged="OnRgbChanged" MaxLength="3"/>
                        </Grid>
                    </UniformGrid>

                    <!-- Quick presets -->
                    <ItemsControl ItemsSource="{Binding Presets, ElementName=Root}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="20" Height="20" Margin="0,0,4,4" Padding="0"
                                        Cursor="Hand" Tag="{Binding}"
                                        Click="OnPresetPick" ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Sw" CornerRadius="4"
                                                    Background="{Binding}"
                                                    BorderBrush="#22000000" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Sw" Property="BorderBrush" Value="#FF2563EB"/>
                                                    <Setter TargetName="Sw" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="{loc:T Dialog_Cancel}" MinWidth="72" Click="OnCancel"/>
                        <ui:Button Appearance="Primary"
                                   Content="{loc:T ColorPicker_Apply}" MinWidth="72" Margin="8,0,0,0"
                                   Click="OnApply"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
