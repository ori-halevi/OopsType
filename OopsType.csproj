<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OopsType</AssemblyName>
    <RootNamespace>OopsType</RootNamespace>
    <!-- Embedded as the EXE's shell icon (taskbar, Alt-Tab, file explorer). -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="WPF-UI" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Language packs ship next to the .exe so users can drop new JSON files into the
         Languages folder without rebuilding. PreserveNewest avoids clobbering files the user
         edited manually during a debug-rebuild cycle. -->
    <Content Include="Languages\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Logos: Resource = baked into the assembly so pack:// URIs work at runtime
         for the window/title-bar/sidebar icons. -->
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\logo-128.ico" />
    <Resource Include="Assets\logo-64.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
