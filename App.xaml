<prism:PrismApplication x:Class="OopsType.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OopsType"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- App-level so it resolves from inside Popup visual trees (e.g. the language picker),
                 which don't chain back to a control's local resources. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisCollapsed"/>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
